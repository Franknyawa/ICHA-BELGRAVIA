// ============================================================================
// BELGRAVIA — Recensement & qualification terrain — Schéma Prisma (PostgreSQL)
// Principes : rien n'est codé en dur (référentiels en base), idempotence
// (uuidClient sur les écritures terrain), pagination systématique côté admin.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// RÉFÉRENTIELS (modifiables depuis l'admin, jamais codés en dur dans le code)
// ---------------------------------------------------------------------------

model Ville {
  id        String       @id @default(uuid())
  nom       String       @unique
  actif     Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  pointsVente PointVente[]

  @@map("villes")
}

model TypeEtablissement {
  id          String       @id @default(uuid())
  nom         String       @unique
  actif       Boolean      @default(true)
  ordre       Int          @default(0)
  pointsVente PointVente[]

  @@map("types_etablissement")
}

model Marque {
  id          String               @id @default(uuid())
  nom         String               @unique
  actif       Boolean              @default(true)
  ordre       Int                  @default(0)
  presences   MarquePresente[]

  @@map("marques")
}

// ---------------------------------------------------------------------------
// UTILISATEURS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  COMMERCIAL
}

model User {
  id           String    @id @default(uuid())
  // Admin : email + mot de passe. Commercial : identifiant + code personnel.
  identifiant  String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  nom          String
  prenom       String
  telephone    String?
  villeId      String?   @map("ville_id")
  actif        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Position "en direct" — alimentée par un battement envoyé depuis la PWA
  // terrain tant que l'application reste ouverte (voir
  // components/LocationHeartbeat.tsx). Ce n'est pas un suivi permanent en
  // arrière-plan : sans l'app ouverte récemment, la position affichée côté
  // admin est la dernière connue, avec son horodatage.
  dernierePositionLat Decimal?  @db.Decimal(10, 7) @map("derniere_position_lat")
  dernierePositionLng Decimal?  @db.Decimal(10, 7) @map("derniere_position_lng")
  dernierePositionAt  DateTime? @map("derniere_position_at")

  pointsVenteCrees PointVente[]
  visites          Visite[]
  commandes        Commande[]
  sessions         Session[]
  notifications    Notification[]

  @@index([role])
  @@map("users")
}

/// Notification adressée à un commercial (ex. commande passée en livraison
/// par l'admin) — affichée dans l'appli terrain (voir NotificationBanner),
/// avec repli sur un polling léger si le flux temps réel (SSE) est coupé.
model Notification {
  id           String   @id @default(uuid())
  commercialId String   @map("commercial_id")
  commercial   User     @relation(fields: [commercialId], references: [id])
  commandeId   String?  @map("commande_id")
  message      String
  lu           Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([commercialId])
  @@index([createdAt])
  @@map("notifications")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  revoked    Boolean  @default(false)

  @@index([userId])
  @@map("sessions")
}

/// Type d'alerte détectée automatiquement (job planifié ou déclenchement
/// manuel depuis l'admin) — voir lib/alertes.ts. Restreint aux situations
/// que le modèle de données BELGRAVIA permet réellement de détecter
/// (contrairement au projet HYPO/HTC, pas de prospects/clients ici).
enum TypeAlerte {
  STOCK_FAIBLE
  LIVRAISON_A_VENIR
  LIVRAISON_RETARD
  CREDIT_RETARD
}

/// Alerte générée automatiquement — affichée dans l'onglet Alertes de
/// l'admin, marquée résolue manuellement (ou en se corrigeant d'elle-même,
/// une prochaine génération ne recrée pas de doublon pour une même entité
/// tant qu'une alerte identique non résolue existe déjà).
model Alerte {
  id         String     @id @default(uuid())
  type       TypeAlerte
  message    String
  entiteType String?    @map("entite_type")
  entiteId   String?    @map("entite_id")
  resolue    Boolean    @default(false)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([type, resolue])
  @@index([createdAt])
  @@map("alertes")
}

// ---------------------------------------------------------------------------
// TERRAIN — POINTS DE VENTE + FORMULAIRE DE RECENSEMENT (Visite)
// ---------------------------------------------------------------------------

enum StatutPointVente {
  OUVERT
  FERME_TEMPORAIREMENT
  EN_TRAVAUX
}

enum ReponseCocktails {
  OUI
  NON
  INTERESSE
}

enum CapaciteEstimee {
  MOINS_20
  DE_20_A_50
  DE_50_A_100
  PLUS_100
}

enum PotentielEstime {
  FORT
  MOYEN
  FAIBLE
}

enum Repondant {
  GERANT_PATRON
  EMPLOYE
  AUTRE
}

model PointVente {
  id                String             @id @default(uuid())
  // Section 2
  nomEtablissement  String             @map("nom_etablissement")
  nomVendeur        String?            @map("nom_vendeur")
  telVendeur        String?            @map("tel_vendeur")
  telPatron         String?            @map("tel_patron")
  villeId           String?            @map("ville_id")
  ville             Ville?             @relation(fields: [villeId], references: [id])
  quartier          String?
  repereQuartier    String?            @map("repere_quartier")
  typeId            String?            @map("type_id")
  type              TypeEtablissement? @relation(fields: [typeId], references: [id])
  typeAutrePrecision String?           @map("type_autre_precision")
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  precisionGps      Decimal?           @map("precision_gps") @db.Decimal(6, 2)
  statut            StatutPointVente   @default(OUVERT)

  createdById String   @map("created_by")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  visites Visite[]
  commandes Commande[]
  photos  Photo[]

  @@index([villeId])
  @@index([typeId])
  @@index([createdAt])
  @@map("points_vente")
}

/// Une "visite" = un remplissage complet du formulaire terrain (sections 3 et 4
/// + horodatage/agent de la section 1). uuidClient garantit l'idempotence si le
/// formulaire est renvoyé après une coupure réseau (PWA offline-first).
model Visite {
  id           String   @id @default(uuid())
  uuidClient   String   @unique @map("uuid_client")
  pointVenteId String   @map("point_vente_id")
  pointVente   PointVente @relation(fields: [pointVenteId], references: [id])
  commercialId String   @map("commercial_id")
  commercial   User     @relation(fields: [commercialId], references: [id])
  dateVisite   DateTime @map("date_visite")

  // Section 3 — Offre et potentiel
  vendSpiritueux      Boolean?          @map("vend_spiritueux")
  proposeCocktails    ReponseCocktails? @map("propose_cocktails")
  capaciteEstimee     CapaciteEstimee?  @map("capacite_estimee")
  affluence           Json?             // [{ jour: "LUNDI", creneaux: ["MATIN","SOIR"] }, ...]
  fournisseurGrossiste Boolean          @default(false) @map("fournisseur_grossiste")
  fournisseurMarche    Boolean          @default(false) @map("fournisseur_marche")
  fournisseurLivraison Boolean          @default(false) @map("fournisseur_livraison")
  fournisseurNeSaitPas Boolean          @default(false) @map("fournisseur_ne_sait_pas")

  // Section 4 — Qualification commerciale
  potentielEstime      PotentielEstime?  @map("potentiel_estime")
  interesseVisiteCommerciale Boolean?    @map("interesse_visite_commerciale")
  observations         String?
  repondant             Repondant?
  repondantAutrePrecision String?        @map("repondant_autre_precision")
  veutCommander         Boolean?         @map("veut_commander")

  createdAt DateTime @default(now()) @map("created_at")

  marquesPresentes MarquePresente[]
  photos           Photo[]

  @@index([pointVenteId])
  @@index([commercialId])
  @@index([dateVisite])
  @@map("visites")
}

/// Table de liaison : marques présentes cochées pour une visite, + jusqu'à 3
/// marques libres saisies par l'agent ("Autre 1/2/3") stockées avec marqueId
/// nul et libelleLibre renseigné.
model MarquePresente {
  id           String   @id @default(uuid())
  visiteId     String   @map("visite_id")
  visite       Visite   @relation(fields: [visiteId], references: [id], onDelete: Cascade)
  marqueId     String?  @map("marque_id")
  marque       Marque?  @relation(fields: [marqueId], references: [id])
  libelleLibre String?  @map("libelle_libre")

  @@index([visiteId])
  @@map("marques_presentes")
}

model Photo {
  id           String      @id @default(uuid())
  uuidClient   String      @unique @map("uuid_client")
  pointVenteId String      @map("point_vente_id")
  pointVente   PointVente  @relation(fields: [pointVenteId], references: [id])
  visiteId     String?     @map("visite_id")
  visite       Visite?     @relation(fields: [visiteId], references: [id])
  url          String
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([pointVenteId])
  @@map("photos")
}

// ---------------------------------------------------------------------------
// PRISE DE COMMANDE
// ---------------------------------------------------------------------------

/// Référentiel produits BELGRAVIA (modifiable depuis l'admin, jamais codé en
/// dur) — figé côté commercial : l'agent choisit uniquement parmi les
/// produits actifs ici, il ne peut pas en créer un depuis son interface
/// (voir app/(commercial)/terrain/nouvelle-commande/page.tsx). `prixUnitaire`
/// est conservé pour compatibilité/affichage admin, mais le prix réellement
/// appliqué à une commande vient du barème par palier de cartons
/// (PalierPrixCarton), recalculé côté serveur à chaque commande — jamais
/// codé en dur dans le formulaire.
model Produit {
  id             String           @id @default(uuid())
  nom            String           @unique
  volumeMl       Int              @default(275) @map("volume_ml")
  prixUnitaire   Decimal          @db.Decimal(10, 2) @map("prix_unitaire")
  actif          Boolean          @default(true)
  ordre          Int              @default(0)
  lignesCommande LigneCommande[]
  stock          Stock?
  mouvementsStock MouvementStock[]

  @@map("produits")
}

/// Barème de prix au carton selon le volume total de la commande (tous
/// produits confondus) — modifiable depuis l'admin (onglet Paramètres),
/// jamais codé en dur dans le formulaire de commande. cartonsMax = null
/// signifie "et plus" (dernier palier, ouvert).
model PalierPrixCarton {
  id          String   @id @default(uuid())
  cartonsMin  Int      @map("cartons_min")
  cartonsMax  Int?     @map("cartons_max")
  prixCarton  Decimal  @db.Decimal(10, 2) @map("prix_carton")
  ordre       Int      @default(0)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("paliers_prix_carton")
}

enum ModePaiement {
  ESPECES
  MOBILE_MONEY
  CREDIT_PARTIEL
  CREDIT_TOTAL
}

/// Cycle de vie côté admin — NON_TRAITEE dès l'enregistrement par le
/// commercial ; l'admin fait passer à EN_COURS_LIVRAISON via le bouton
/// "Valider" (déclenche une notification au commercial concerné), puis à
/// LIVREE une fois la livraison effective confirmée.
enum StatutCommande {
  NON_TRAITEE
  EN_COURS_LIVRAISON
  LIVREE
}

model Commande {
  id            String       @id @default(uuid())
  uuidClient    String       @unique @map("uuid_client")
  pointVenteId  String       @map("point_vente_id")
  pointVente    PointVente   @relation(fields: [pointVenteId], references: [id])
  commercialId  String       @map("commercial_id")
  commercial    User         @relation(fields: [commercialId], references: [id])
  dateCommande  DateTime     @default(now()) @map("date_commande")
  dateLivraison DateTime?    @map("date_livraison")
  statut        StatutCommande @default(NON_TRAITEE)
  observations  String?
  montantTotal  Decimal      @default(0) @db.Decimal(12, 2) @map("montant_total")

  // Paiement — calculé et validé côté serveur selon modePaiement (voir
  // app/api/commandes/route.ts) : jamais de confiance dans un montant
  // envoyé par le client pour ESPECES/MOBILE_MONEY/CREDIT_TOTAL.
  // mobileMoneyConfirme : tant que l'agent n'a pas confirmé la réception
  // effective du paiement Mobile Money (peut arriver après la commande),
  // le montant est traité comme un crédit en attente — même logique que le
  // projet HYPO/HTC (voir reassort/page.tsx : montantEffectivementRecu).
  modePaiement       ModePaiement @default(ESPECES) @map("mode_paiement")
  mobileMoneyConfirme Boolean     @default(false) @map("mobile_money_confirme")
  montantRecu   Decimal      @default(0) @db.Decimal(12, 2) @map("montant_recu")
  resteAPayer   Decimal      @default(0) @db.Decimal(12, 2) @map("reste_a_payer")

  createdAt    DateTime @default(now()) @map("created_at")

  lignes LigneCommande[]

  @@index([pointVenteId])
  @@index([commercialId])
  @@index([createdAt])
  @@index([modePaiement])
  @@index([statut])
  @@map("commandes")
}

/// libelleLibre est conservé en base pour l'historique des commandes créées
/// avant ce correctif, mais n'est plus utilisable depuis le formulaire
/// terrain : chaque nouvelle ligne référence obligatoirement un Produit du
/// référentiel (produitId non nul).
model LigneCommande {
  id            String    @id @default(uuid())
  commandeId    String    @map("commande_id")
  commande      Commande  @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId     String?   @map("produit_id")
  produit       Produit?  @relation(fields: [produitId], references: [id])
  libelleLibre  String?   @map("libelle_libre")
  quantite      Int
  prixUnitaire  Decimal   @db.Decimal(10, 2) @map("prix_unitaire")
  sousTotal     Decimal   @db.Decimal(12, 2) @map("sous_total")

  @@index([commandeId])
  @@map("lignes_commande")
}

// ---------------------------------------------------------------------------
// STOCK (entrées/sorties liées aux commandes, ajustements manuels admin)
// ---------------------------------------------------------------------------

model Stock {
  id              String   @id @default(uuid())
  produitId       String   @unique @map("produit_id")
  produit         Produit  @relation(fields: [produitId], references: [id])
  quantiteCartons Int      @default(0) @map("quantite_cartons")
  seuilAlerte     Int      @default(0) @map("seuil_alerte")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("stock")
}

enum TypeMouvementStock {
  ENTREE
  SORTIE
  AJUSTEMENT
}

model MouvementStock {
  id              String             @id @default(uuid())
  produitId       String             @map("produit_id")
  produit         Produit            @relation(fields: [produitId], references: [id])
  type            TypeMouvementStock
  quantiteCartons Int                @map("quantite_cartons")
  referenceType   String?            @map("reference_type") // "COMMANDE" | "AJUSTEMENT"
  referenceId     String?            @map("reference_id")
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at")

  @@index([produitId])
  @@index([createdAt])
  @@map("mouvements_stock")
}
