# --- Base de données : Supabase (PostgreSQL) ---
# Dans le dashboard Supabase : Project Settings > Database > Connection string.
# DATABASE_URL = connexion "poolée" (Supavisor, port 6543) — utilisée par l'app à l'exécution.
# DIRECT_URL   = connexion directe (port 5432) — utilisée par Prisma pour les migrations.
DATABASE_URL="postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<mot-de-passe>@db.<ref-projet>.supabase.co:5432/postgres"

# Clé secrète pour la signature des sessions (générer une chaîne aléatoire longue)
SESSION_SECRET="change-moi-en-production"

# --- Stockage des photos ---
# "local" (dev, disque du serveur) | "sftp" (hébergement LWS) | "s3" (S3-compatible)
STORAGE_DRIVER="sftp"

# Requis si STORAGE_DRIVER=sftp (hébergement LWS mutualisé/VPS, accès FTP/SFTP) :
SFTP_HOST="ftp.mondomaine.fr"        # ou l'hôte SFTP donné par LWS
SFTP_PORT="22"
SFTP_USER=""
SFTP_PASSWORD=""                      # ou SFTP_PRIVATE_KEY (clé privée PEM) à la place
# SFTP_PRIVATE_KEY=""
SFTP_REMOTE_DIR="www/uploads"         # dossier PUBLIC de l'hébergement — à adapter à ton arborescence LWS
SFTP_PUBLIC_URL_BASE="https://mondomaine.fr/uploads"

# Requis si STORAGE_DRIVER=s3 :
# S3_BUCKET="belgravia-photos"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""            # pour Cloudflare R2 / MinIO — laisser vide pour AWS S3
# S3_PUBLIC_URL_BASE=""     # URL publique/CDN devant le bucket
